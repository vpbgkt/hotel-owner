# Bootstrap config — used ONLY before a certificate exists yet.
# init-letsencrypt.sh swaps this in first (HTTP only) so Certbot's HTTP-01
# challenge can succeed, then switches to app.conf.template which adds :443.
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 200 'Server is starting up — SSL certificate is being issued.';
        add_header Content-Type text/plain;
    }
}
