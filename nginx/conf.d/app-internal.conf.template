# Internal reverse proxy — Hotel Manager
# Plain HTTP only. Bound to 127.0.0.1 on the host (see docker-compose.yml).
# The host's own Nginx terminates TLS and forwards here, same pattern as the
# other sites already running on this VPS.

server {
    listen 80;
    server_name _;

    client_max_body_size 15m;

    # ── Backend API ────────────────────────────────────────────────────────────
    location /api/ {
        proxy_pass http://api:4000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Uploaded files served directly by the backend ─────────────────────────
    location /uploads/ {
        proxy_pass http://api:4000/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Backend health check ───────────────────────────────────────────────────
    location /health {
        proxy_pass http://api:4000/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # ── Frontend (Next.js) — everything else ──────────────────────────────────
    location / {
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
