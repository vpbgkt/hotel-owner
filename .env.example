# ─────────────────────────────────────────────────────────────────────────────
# Root .env — used by docker-compose.yml and init-letsencrypt.sh
# Copy to .env and fill in before running `docker compose up`.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Domain & SSL ─────────────────────────────────────────────────────────────
# The domain you pointed at this VPS (A record). No protocol, no trailing slash.
DOMAIN=yourdomain.com
LETSENCRYPT_EMAIL=you@example.com

# ─── Redis (container-internal cache, not exposed publicly) ──────────────────
REDIS_PASSWORD=change-this-to-a-strong-random-password

# ─── Frontend build-time vars (baked into the Next.js bundle) ────────────────
# Relative path works because Nginx proxies /api on the same domain in prod.
NEXT_PUBLIC_API_URL=/api
# Optional — only needed if you take live payments via Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
