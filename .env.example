# ─────────────────────────────────────────────────────────────────────────────
# Root .env — used by docker-compose.yml
# Copy to .env and fill in before running `docker compose up`.
#
# TLS is terminated by the HOST's existing Nginx (shared with other sites on
# this VPS), not by a container. This stack's nginx only listens on
# 127.0.0.1:${HOTEL_NGINX_PORT} — point your host nginx's server block at it.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Internal port (loopback only — pick something free on this VPS) ────────
HOTEL_NGINX_PORT=8081

# ─── Public domain (used only as a build-time value, e.g. CORS/email links
# inside backend/.env.production — not used by this file's nginx) ────────────
DOMAIN=yourdomain.com

# ─── Redis (container-internal cache, not exposed publicly) ──────────────────
REDIS_PASSWORD=change-this-to-a-strong-random-password

# ─── Frontend build-time vars (baked into the Next.js bundle) ────────────────
# Relative path works because Nginx proxies /api on the same domain in prod.
NEXT_PUBLIC_API_URL=/api
# Optional — only needed if you take live payments via Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
