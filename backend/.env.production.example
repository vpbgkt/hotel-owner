# ─────────────────────────────────────────────────────────────────────────────
# Backend production env — copy to backend/.env.production and fill in.
# Loaded by docker-compose via `env_file`. REDIS_* are injected separately by
# docker-compose (pointing at the internal Redis container) — do not set them here.
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=production

# ─── Hotel Identity ───────────────────────────────────────────────────────────
HOTEL_ID=11111111-1111-1111-1111-111111111111

# ─── Supabase PostgreSQL ──────────────────────────────────────────────────────
# From Supabase dashboard: Project Settings -> Database -> Connection string.
# Prefer the "Session" pooler (port 6543) or direct connection (port 5432) —
# NOT the "Transaction" pooler, which is incompatible with Sequelize's default
# prepared-statement usage.
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-db-password
DB_SSL=true
# Forces the app to use Supabase Postgres directly — no SQLite/pg-mem fallback.
DB_FORCE_POSTGRES=true

# ─── JWT — generate with: openssl rand -base64 48 ────────────────────────────
JWT_ACCESS_SECRET=replace-with-a-real-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS — your public site URL (used for email links + CORS allow-list) ───
FRONTEND_URL=https://yourdomain.com

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ─── Razorpay (Payment Gateway) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Your Hotel Name

# ─── SMS (MSG91) — optional ───────────────────────────────────────────────────
MSG91_API_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
